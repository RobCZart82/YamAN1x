+void an1x_state::boot_observe(const char *kind, unsigned number, u32 pc, u8 ccr, u16 mask)
+{
+    if (m_boot_count == 8192) {
+        ++m_boot_dropped;
+        return;
+    }
+    logerror("YAMANIX BOOT_IRQ seq=%u kind=%s value=%x pc=%06x ccr=%02x mask=%04x time_ns=%llu\n",
+        m_boot_count++, kind, number, pc & 0xffffff, unsigned(ccr), unsigned(mask),
+        (unsigned long long)machine().time().as_ticks(1000000000));
+}
